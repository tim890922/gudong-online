{
  "name": "gudong-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:app": "vue-tsc -b && vite build --mode app --outDir dist-app",
    "cap:sync": "npm run build:app && cap sync",
    "icons": "node scripts/icons.mjs && capacitor-assets generate --ios --android",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/barcode-scanner": "^3.1.3",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/share": "^8.0.3",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=22.12"
  }
}
