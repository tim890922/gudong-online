# 對外網址：用來產生邀請連結和 QR code。留空時使用瀏覽器目前的網址。
# 例如 https://gudong.example.com 或區網 http://192.168.1.20:8000
PUBLIC_BASE_URL=

# 對外的 port（只影響主機端）
PORT=8000

# 房間閒置多久後清除（小時）
ROOM_TTL_HOURS=12

# Cloudflare Named Tunnel 的 token（Zero Trust 後台 → Networks → Tunnels 建立後取得）
# 公開的主機名稱請指向 http://app:8000
TUNNEL_TOKEN=
